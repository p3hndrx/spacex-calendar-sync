# Google Calendar ID to sync SpaceX launches into.
# Find it under Calendar Settings > Integrate Calendar > Calendar ID.
# Example: abc123xyz@group.calendar.google.com
GOOGLE_CALENDAR_ID=your-calendar-id@group.calendar.google.com

# For LOCAL DEVELOPMENT only.
# Path to a service account JSON key file with Calendar API access.
# In Cloud Run, leave this unset and attach the service account to the service instead.
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json
