# Google Calendar ID for the dedicated SpaceX launches calendar.
# Find it in Google Calendar > Settings > your calendar > Integrate Calendar > Calendar ID.
# Example: abc123xyz@group.calendar.google.com
GOOGLE_CALENDAR_ID=your-calendar-id@group.calendar.google.com

# Full path to your service account JSON key file.
# setup.sh will set this automatically to <repo-dir>/service-account-key.json.
GOOGLE_APPLICATION_CREDENTIALS=/home/your-username/projects/spacex-calendar-sync/service-account-key.json

# Email notifications (optional).
# Generate an App Password at: https://myaccount.google.com/apppasswords
# GMAIL_USER=you@gmail.com
# GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# NOTIFY_EMAIL=you@gmail.com

# Launch Library 2 API key (optional).
# Without a key the free tier allows 15 requests/hour — plenty for a daily cron.
# Get a key at https://thespacedevs.com/supportus to raise the limit.
# LL2_API_KEY=your-api-key-here
